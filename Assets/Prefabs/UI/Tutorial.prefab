  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6057386634303732760}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: baa0b2822f09d46ef8008fa3d47121a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  _isGlobal: 0
  panel: {fileID: 5161206108211144528}
  pageText: {fileID: 2023823810285167329}
  pageImage: {fileID: 1983343834686056486}
  actionButtonLabel: {fileID: 5436582056427789750}
  actionButton: {fileID: 5304358462306167625}
  skipButton: {fileID: 7647102723435459357}
  charactersPerSecond: 40
  levelTutorials:
  - level: 1
    pages:
    - text: Hi! Welcome to your new role as a rocket designer at Space Express.
      image: {fileID: 21300000, guid: bfb897bf52c3b43f0ac3428f849bc08b, type: 3}
      actionLabel: Hello!
      onAction:
        m_PersistentCalls:
          m_Calls: []
    - text: We usually ask for at least ten years of rocket building experience...
      image: {fileID: 21300000, guid: b26e8d8d147d746e9a0d276c52e6bdfb, type: 3}
      actionLabel: Oh..
      onAction:
        m_PersistentCalls:
          m_Calls: []
    - text: 'But you know our motto: Fail Fast!'
      image: {fileID: 21300000, guid: bfb897bf52c3b43f0ac3428f849bc08b, type: 3}
      actionLabel: Exactly!
      onAction:
        m_PersistentCalls:
          m_Calls: []
    - text: "The special thing about our rockets is that we don\u2019t let ANYTHING
        stand in the way of the march of progress."
      image: {fileID: 21300000, guid: bfb897bf52c3b43f0ac3428f849bc08b, type: 3}
      actionLabel: Gotcha
      onAction:
        m_PersistentCalls:
          m_Calls: []
    - text: "Once we\u2019ve decided we want to launch, we LAUNCH. Our count down
        starts BEFORE the rocket has been constructed, NOTHING can stop it, and the
        rocket WILL launch when the count down finishes."
      image: {fileID: 21300000, guid: bfb897bf52c3b43f0ac3428f849bc08b, type: 3}
      actionLabel: Ah
      onAction:
        m_PersistentCalls:
          m_Calls: []
    - text: "Let\u2019s try it now. Use [LEFT ARROW] and [RIGHT ARROW] to move rocket
        pieces. Press [UP ARROW] to rotate and press [DOWN ARROW] to accelerate the
        piece."
      image: {fileID: 21300000, guid: bfb897bf52c3b43f0ac3428f849bc08b, type: 3}
      actionLabel: Sure
      onAction:
        m_PersistentCalls:
          m_Calls: []
    - text: 'Oh one last thing: the CARGO. The cargo is VERY important. It''ll drop
        automatically right before takeoff. Ready to go? '
      image: {fileID: 21300000, guid: b26e8d8d147d746e9a0d276c52e6bdfb, type: 3}
      actionLabel: Of Course!
      onAction:
        m_PersistentCalls:
          m_Calls: []
